# Exclude specific subdirectories
recursive-exclude src/agent_proving_ground/tool/_tools/_computer/_resources *
recursive-exclude src/agent_proving_ground/tool/_tools/_web_browser/_resources *

# Trim the sdist: none of these are needed to build or install from it
# (the JS viewer ships prebuilt as src/agent_proving_ground/_view/dist). See #4588.
prune tests
prune src/apg_sandbox_tools/tests
prune docs
prune src/agent_proving_ground/_view/ts-mono
exclude uv.lock
exclude yarn.lock
